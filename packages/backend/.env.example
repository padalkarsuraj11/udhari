# ============================================================
# UDHARI PLATFORM — Backend Environment Variables
# Copy this to .env and fill in your actual values
# ============================================================

# Server Configuration
NODE_ENV=development
PORT=4000

# CORS Origins (Frontend URLs)
ADMIN_ORIGIN=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5174

# Supabase Configuration
# Get these from your Supabase project: Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# CRITICAL SECURITY: NEVER expose this key in frontend code
# This key bypasses RLS and has full database access
# Only use server-side for admin operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret (used for custom token verification if needed)
# JWT_SECRET=your-random-secret-here
